#!/usr/bin/env bash
BRANCH=$(git branch --show-current 2>/dev/null)
# Fallback to directory basename for any empty-branch case: not a repo, fresh
# repo with no commits, or detached HEAD. Beats a useless "unknown" session.
[[ -z "$BRANCH" ]] && BRANCH=$(basename "$PWD")
SESSION=$(echo "$BRANCH" | tr '/' '-')

if [ -z "$TMUX" ]; then
  # Not in tmux — create session running Claude, or attach if it already exists
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach-session -t "$SESSION"
  else
    exec tmux new-session -s "$SESSION" -c "$PWD" "claude $*; exec $SHELL"
  fi
else
  # Already in tmux — just start Claude
  exec claude "$@"
fi
