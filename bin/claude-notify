#!/usr/bin/env bash
cat > /dev/null
PROJECT=${NYX_PROJECT:-$(basename "$PWD")}
BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")

if [ -n "$TMUX" ]; then
  tmux rename-window "⚡ $PROJECT"
fi

terminal-notifier \
  -title "$PROJECT - $BRANCH" \
  -message "needs your attention" \
  -sound Glass \
  -activate com.mitchellh.ghostty
exit 0
