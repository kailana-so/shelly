#!/usr/bin/env bash
DOCS_DIR="${VIEWTREES_DIR:-$HOME/Documents}"

# fzf row format: name|display-text
_HDR=$'ctrl-r refresh  ·  ESC quit  ·  ✓ claude:done  ⚡ session  - none
────────────────────────────────────────────────────────────────────
📁 repo                        | 🌾 branch | 📤 last commit
────────────────────────────────────────────────────────────────────'
_COLORS="fg:#d4d4d4,bg:#282c35,fg+:#ffffff,bg+:#484e5b,hl:#6699cc,hl+:#6699cc"
_COLORS+=",info:#7f7f7f,prompt:#a9cfa4,pointer:#f1a5ab,header:#7f7f7f,border:#484e5b"

tmux_names=()
tmux_wins=()

# ── helpers ────────────────────────────────────────────────────────────────────

_tmux_index() {
  local name="$1" i
  for i in "${!tmux_names[@]}"; do
    [[ "${tmux_names[$i]}" == "$name" ]] && echo "$i" && return
  done
  echo "-1"
}

_status_icon() {
  local win="$1"
  [[ "$win" == ✓* ]] && echo "✓ " || echo "⚡ "
}

# A worktree's .git is a file (gitlink), not a directory. Reliable detector.
_is_worktree() {
  [[ -n "$1" && -f "$1/.git" ]]
}

# ── Ghostty native splits ──────────────────────────────────────────────────────

_ghostty_open_claude() {
  local path="$1"
  osascript - "$path" <<'APPLESCRIPT' >/dev/null
on run argv
  set wdir to item 1 of argv
  tell application "Ghostty"
    split (focused terminal of selected tab of front window) direction right ¬
      with configuration {initial working directory:wdir, initial input:"claude" & return}
  end tell
  return
end run
APPLESCRIPT
}

_ghostty_open_nyx() {
  local path="$1"
  local proj
  proj=$(basename "$path")
  osascript - "$path" "$proj" <<'APPLESCRIPT' >/dev/null
on run argv
  set wdir to item 1 of argv
  set projName to item 2 of argv
  tell application "Ghostty"
    split (focused terminal of selected tab of front window) direction right ¬
      with configuration {initial working directory:wdir, initial input:("nyx projects -sw " & quoted form of projName & " && nyx chat" & return)}
  end tell
  return
end run
APPLESCRIPT
}

_ghostty_focus_session() {
  local target="$1" name="$2"
  [[ -z "$target" && -z "$name" ]] && return 1
  local result
  result=$(osascript - "$target" "$name" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set targetPath to item 1 of argv
  set sessionName to item 2 of argv
  tell application "Ghostty"
    repeat with w in every window
      repeat with t in (every tab of w)
        repeat with term in (every terminal of t)
          try
            set wdir to (working directory of term) as text
            if wdir starts with targetPath then
              focus term
              activate
              return "focused"
            end if
          end try
          try
            set ttl to (name of term) as text
            if ttl contains sessionName then
              focus term
              activate
              return "focused"
            end if
          end try
        end repeat
      end repeat
    end repeat
  end tell
  return "not found"
end run
APPLESCRIPT
  )
  [[ "$result" == "focused" ]]
}

_ghostty_open_shell() {
  local path="$1"
  osascript - "$path" <<'APPLESCRIPT' >/dev/null
on run argv
  set wdir to item 1 of argv
  tell application "Ghostty"
    split (focused terminal of selected tab of front window) direction down ¬
      with configuration {initial working directory:wdir}
  end tell
  return
end run
APPLESCRIPT
}

# ── row generation ─────────────────────────────────────────────────────────────

generate_rows() {
  tmux_names=()
  tmux_wins=()
  if tmux list-sessions &>/dev/null 2>&1; then
    while IFS= read -r s; do
      local win
      win=$(tmux display-message -p -t "$s" '#W' 2>/dev/null || echo "")
      tmux_names+=("$s")
      tmux_wins+=("$win")
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  fi

  _row() {
    local icon="$1" name="$2" path="$3" branch="$4" has_sess="$5"
    local commit pn
    commit=$(git -C "$path" log -1 --format="%s" 2>/dev/null | tr '|' '-')
    pn=$(printf '%-28s' "$name")
    printf "%s|%s  \033[1m%s\033[0m  \033[38;2;169;207;164m%s\033[0m  \033[90m%s\033[0m\n" \
      "$name" "$icon" "$pn" "${branch:0:20}" "${commit:0:40}"

    [[ "$has_sess" == "true" ]] && printf "%s|\033[38;2;160;160;160m     →  go to session\033[0m\n"    "$name"
    printf                                "%s|\033[38;2;160;160;160m     ☾  open with nyx\033[0m\n"    "$name"
    printf                                "%s|\033[38;2;160;160;160m     ✦  open with claude\033[0m\n" "$name"
    printf                                "%s|\033[38;2;160;160;160m     ⌂  go to directory\033[0m\n"  "$name"
  }

  local path name branch idx icon has_sess repo_names=()
  while IFS= read -r path; do
    name=$(basename "$path")
    repo_names+=("$name")
    branch=$(git -C "$path" branch --show-current 2>/dev/null || echo "")
    idx=$(_tmux_index "$name")
    if [[ "$idx" != "-1" ]]; then
      icon=$(_status_icon "${tmux_wins[$idx]}"); has_sess="true"
    else
      icon="- "; has_sess="false"
    fi
    _row "$icon" "$name" "$path" "$branch" "$has_sess"
  done < <(find "$DOCS_DIR" -maxdepth 2 -name ".git" -type d 2>/dev/null | sed 's|/.git$||' | sort)

  # Orphan tmux sessions (session with no matching repo in DOCS_DIR)
  local s matched p pn s_path
  for i in "${!tmux_names[@]}"; do
    s="${tmux_names[$i]}"
    matched=false
    for p in "${repo_names[@]}"; do
      [[ "$p" == "$s" ]] && matched=true && break
    done
    $matched && continue
    icon=$(_status_icon "${tmux_wins[$i]}")
    pn=$(printf '%-28s' "$s")
    s_path=$(tmux display-message -p -t "${s}:" '#{session_path}' 2>/dev/null || echo "")
    printf "%s|%s  \033[1m%s\033[0m\n" "$s" "$icon" "$pn"
    printf "%s|\033[38;2;160;160;160m     →  go to session\033[0m\n"    "$s"
    [[ -n "$s_path" ]] && printf "%s|\033[38;2;160;160;160m     ☾  open with nyx\033[0m\n"    "$s"
    [[ -n "$s_path" ]] && printf "%s|\033[38;2;160;160;160m     ✦  open with claude\033[0m\n" "$s"
    [[ -n "$s_path" ]] && printf "%s|\033[38;2;160;160;160m     ⌂  go to directory\033[0m\n"  "$s"
    printf                "%s|\033[38;2;214;143;143m     ✕  kill session\033[0m\n"     "$s"
    _is_worktree "$s_path" && printf "%s|\033[38;2;160;160;160m     ☓  prune worktree\033[0m\n" "$s"
  done
  return 0
}

# ── entry points ───────────────────────────────────────────────────────────────

[[ "${1:-}" == "--rows" ]] && generate_rows && exit 0

# ── interactive picker ─────────────────────────────────────────────────────────

while true; do
  selected=$(generate_rows | fzf \
    --ansi \
    --no-sort \
    --layout reverse \
    --delimiter '|' \
    --with-nth 2 \
    --padding '0,1' \
    --bind "ctrl-r:reload($0 --rows 2>/dev/null)" \
    --color "${_COLORS}" \
    --border rounded \
    --header "${_HDR}")

  [[ -z "$selected" ]] && exit 0

  name=$(cut -d'|' -f1 <<< "$selected")
  field2=$(cut -d'|' -f2- <<< "$selected")
  display=$(sed $'s/\033\\[[0-9;]*m//g' <<< "$field2")

  if [[ "$display" =~ ^[[:space:]] ]]; then
    action=$(sed 's/^[[:space:]]*//' <<< "$display")
  else
    action=""
  fi

  # Resolve path from DOCS_DIR; fall back to tmux session path for orphans
  path=""
  while IFS= read -r p; do
    [[ "$(basename "$p")" == "$name" ]] && path="$p" && break
  done < <(find "$DOCS_DIR" -maxdepth 2 -name ".git" -type d 2>/dev/null | sed 's|/.git$||')
  [[ -z "$path" ]] && path=$(tmux display-message -p -t "${name}:" '#{session_path}' 2>/dev/null || echo "")

  has_session=false
  tmux has-session -t "$name" 2>/dev/null && has_session=true

  if [[ -z "$action" ]]; then
    $has_session && action="→  go to session" || action="✦  open with claude"
  fi

  case "$action" in
    "→  go to session")
      if $has_session; then
        if [[ -n "$TMUX" ]]; then
          tmux switch-client -t "$name"
        else
          _ghostty_focus_session "$path" "$name" || exec tmux attach -t "$name"
        fi
      elif [[ -n "$path" ]]; then
        if [[ -n "$TMUX" ]]; then
          tmux new-session -d -s "$name" -c "$path" "exec $SHELL"
          tmux switch-client -t "$name"
        else
          exec tmux new-session -s "$name" -c "$path"
        fi
      fi
      ;;
    "☾  open with nyx")
      [[ -n "$path" ]] && _ghostty_open_nyx "$path"
      ;;
    "✦  open with claude")
      [[ -n "$path" ]] && _ghostty_open_claude "$path"
      ;;
    "✕  kill session")
      if tmux has-session -t "$name" 2>/dev/null; then
        echo
        echo "  kill tmux session: $name"
        if gum confirm "Kill it?"; then
          tmux kill-session -t "$name"
          echo "  killed."
        else
          echo "  aborted."
        fi
      else
        echo "no session named '$name' to kill" >&2
      fi
      ;;
    "☓  prune worktree")
      if _is_worktree "$path"; then
        # Find the parent repo (first row of `worktree list --porcelain` is the main worktree).
        parent_repo=$(git -C "$path" worktree list --porcelain 2>/dev/null | head -n 1 | awk '{print $2}')
        if [[ -z "$parent_repo" ]]; then
          echo "Couldn't resolve parent repo for $path" >&2
          continue
        fi
        echo
        echo "  prune worktree:  $name"
        echo "  path:            $path"
        echo "  parent repo:     $parent_repo"
        if gum confirm "Kill its session and remove the worktree?"; then
          tmux has-session -t "$name" 2>/dev/null && tmux kill-session -t "$name"
          git -C "$parent_repo" worktree remove --force "$path" 2>&1 || \
            echo "  warning: git worktree remove failed; directory may need manual cleanup"
          git -C "$parent_repo" worktree prune
          echo "  pruned."
        else
          echo "  aborted."
        fi
      else
        echo "$path is not a worktree (no gitlink at .git)" >&2
      fi
      ;;
    "⌂  go to directory")
      [[ -n "$path" ]] && _ghostty_open_shell "$path"
      ;;
  esac
done
