  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6B9DB8", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#D4A017" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#B0B0B4" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "string.regexp"],
      "settings": { "foreground": "#8AADA6" }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": { "foreground": "#6DB87A" }
    },
    {
      "name": "Numbers & booleans",
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#F7B485" }
    },
    {
      "name": "Other constants",
      "scope": ["constant.other"],
      "settings": { "foreground": "#F7B485" }
    },
    {
      "name": "Function definitions",
      "scope": ["entity.name.function"],
      "settings": { "foreground": "#C8B8EC" }
    },
    {
      "name": "Built-in functions & support",
      "scope": ["support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#6DB87A" }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#9ABCCC", "fontStyle": "italic" }
    },
    {
      "name": "Types & classes",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "meta.type.annotation",
        "meta.type",
        "entity.name.type.primitive"
      ],
      "settings": { "foreground": "#9c8dd5" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": { "foreground": "#B0B0B4" }
    },
    {
      "name": "Object properties / keys",
      "scope": [
        "variable.other.property",
        "variable.other.object",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#C4967A" }
    },
    {
      "name": "this / self",
      "scope": ["variable.language.this", "variable.language.self"],
      "settings": { "foreground": "#D4A017", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": ["entity.name.function.decorator", "punctuation.decorator", "meta.decorator"],
      "settings": { "foreground": "#C8B8EC", "fontStyle": "italic" }
    },
    {
      "name": "Namespaces / modules",
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": { "foreground": "#9c8dd5" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition.block",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": { "foreground": "#4A5260" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "#D4A017", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#F7B485", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#C8B8EC", "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.raw.block"],
      "settings": { "foreground": "#8AADA6" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#9c8dd5" }
    },
    {
      "name": "Markdown list bullets",
      "scope": ["markup.list punctuation.definition.list"],
      "settings": { "foreground": "#D4A017" }
    },
    {
      "name": "Markdown blockquote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#6B9DB8", "fontStyle": "italic" }
    },
    {
      "name": "HTML tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#9c8dd5" }
    },
    {
      "name": "HTML attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#8AADA6" }
    },
    {
      "name": "CSS property names",
      "scope": ["support.type.property-name.css"],
      "settings": { "foreground": "#9c8dd5" }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.property-value.css"],
      "settings": { "foreground": "#8AADA6" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.other.attribute-name.class.css", "entity.name.tag.css"],
      "settings": { "foreground": "#C8B8EC" }
    },
    {
      "name": "CSS pseudo-class",
      "scope": ["entity.other.attribute-name.pseudo-class"],
      "settings": { "foreground": "#AF8700" }
    },
    {
      "name": "Invalid / deprecated",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": { "foreground": "#C46060", "fontStyle": "strikethrough" }
    }
  ]
}
